#!/usr/bin/env bash
# Start the screener web app (public frontend + admin).
set -euo pipefail
cd "$(dirname "$0")"

if [[ ! -x .venv/bin/python ]]; then
  echo "Creating .venv ..."
  python3 -m venv .venv
  .venv/bin/pip install -q -r requirements.txt
fi

if ! .venv/bin/python -c "import flask" >/dev/null 2>&1; then
  echo "Installing web dependencies ..."
  .venv/bin/pip install -q -r requirements.txt
fi

exec .venv/bin/python -m src.web_app
